132:   }),
133:   autoshare: Schema.optional(Schema.Boolean).annotate({
134:     description: "@deprecated Use 'share' field instead. Share newly created sessions automatically",
135:   }),
136:   autoupdate: Schema.optional(Schema.Union([Schema.Boolean, Schema.Literal("notify")])).annotate({
137:     description:
138:       "Automatically update to the latest version. Set to true to auto-update, false to disable, or 'notify' to show update notifications",
139:   }),
