235:     />
236:   )
237: }
238: 
239: function show(api: TuiPluginApi) {
240:   api.ui.dialog.replace(() => <View api={api} />)
241: }
242: 
243: const tui: TuiPlugin = async (api) => {
244:   api.command.register(() => [
245:     {
246:       title: "Plugins",
247:       value: "plugins.list",
248:       keybind: "plugin_manager",
249:       category: "System",
250:       onSelect() {
251:         show(api)
252:       },
253:     },
254:     {
255:       title: "Install plugin",
256:       value: "plugins.install",
257:       category: "System",
258:       onSelect() {
259:         showInstall(api)
260:       },
261:     },
262:   ])
263: }
264: 
